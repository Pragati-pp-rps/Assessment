      },
      "id": "d6a04032-5e24-41db-a1d1-e2f443397e8a",
      "name": "Customer Feedback Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1024,
        192
      ],
      "webhookId": "6229f5cd-7b85-46a1-909f-7b9a3ba9596e"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map((item) => {\n\n  // Get incoming Webhook data\n  let body = item.json.body ?? item.json;\n\n  // Handle JSON body received as a string\n  if (typeof body === \"string\") {\n    try {\n      body = JSON.parse(body);\n    } catch (error) {\n      throw new Error(\"Webhook body is not valid JSON\");\n    }\n  }\n\n  // Extract customer information\n  const customer_name = String(\n    body.customer_name ??\n    body.customerName ??\n    body.name ??\n    \"\"\n  ).trim();\n\n  const email = String(\n    body.email ??\n    body.customerEmail ??\n    \"\"\n  ).trim();\n\n  const feedback_text = String(\n    body.feedback_text ??\n    body.feedbackText ??\n    body.feedback ??\n    body.comment ??\n    \"\"\n  ).trim();\n\n  // Get rating\n  const rawRating =\n    body.rating ??\n    body.customerRating ??\n    body.score;\n\n  // Validate rating\n  if (\n    rawRating === undefined ||\n    rawRating === null ||\n    String(rawRating).trim() === \"\"\n  ) {\n    throw new Error(\n      \"Rating missing from Webhook. Received fields: \" +\n      Object.keys(body).join(\", \")\n    );\n  }\n\n  const rating = Number(rawRating);\n\n  if (\n    !Number.isInteger(rating) ||\n    rating < 1 ||\n    rating > 5\n  ) {\n    throw new Error(\n      \"Rating must be an integer between 1 and 5\"\n    );\n  }\n\n  // Validate customer details\n  if (!customer_name) {\n    throw new Error(\"Customer name is required\");\n  }\n\n  if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n    throw new Error(\"Valid email is required\");\n  }\n\n  if (!feedback_text) {\n    throw new Error(\"Feedback text is required\");\n  }\n\n  // Generate feedback ID\n  const now = new Date();\n\n  const date = now.toISOString()\n    .slice(0, 10)\n    .replace(/-/g, \"\");\n\n  const suffix = Math.floor(\n    1000 + Math.random() * 9000\n  );\n\n  const feedback_id = `FBK-${date}-${suffix}`;\n\n  // Sentiment calculation\n  const sentiment =\n    rating >= 4\n      ? \"PROMOTER\"\n      : rating <= 2\n        ? \"DETRACTOR\"\n        : \"NEUTRAL\";\n\n  // Follow-up status\n  const follow_up_status =\n    rating <= 2\n      ? \"Escalated\"\n      : \"Completed\";\n\n  return {\n    json: {\n      feedback_id,\n      customer_name,\n      email,\n      rating,\n      feedback_text,\n      sentiment,\n      submitted_at: now.toISOString(),\n      follow_up_status\n    }\n  };\n\n});\n"
      },
